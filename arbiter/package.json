{
  "name": "@mandusec/arbiter",
  "version": "0.2.0-beta.8",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Mandu arbiter daemon: symbol table + policy interface exposed over a Unix-domain-socket IPC. Lifted from adfi-openclaw (see file provenance headers).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "MANDU_AXES_STRICT=1 MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml MANDU_HOME=/dev/null/mandu-test-home tsx --test test/unit/*.test.ts test/component/*.test.ts",
    "test:unit": "MANDU_AXES_STRICT=1 MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml MANDU_HOME=/dev/null/mandu-test-home tsx --test test/unit/*.test.ts",
    "test:component": "MANDU_AXES_STRICT=1 MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml MANDU_HOME=/dev/null/mandu-test-home tsx --test test/component/*.test.ts",
    "test:integrity": "MANDU_AXES_STRICT=1 MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml MANDU_HOME=/dev/null/mandu-test-home tsx --test test/integrity/*.test.ts",
    "serve": "tsx ipc/server-main.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "re2js": "^2.8.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
