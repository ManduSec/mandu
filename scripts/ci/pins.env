# scripts/ci/pins.env — the ONE list of versions the CI guest image is built
# from (docs/design/testing/continuous-integration.md §4). Plain KEY=value lines, no shell
# expansion: vm-image.sh, the guest's provision.sh and the parity test
# (scripts/test/ci-pins.test.mjs) all read it as data.
#
# A change here changes the image key, so the next run builds a new image.
# packaging/docker/Dockerfile.ci keeps its own ARG defaults for the hand-run
# docker rig; the parity test fails when they differ from these (bump both).
# NODE_VERSION is also the floor .github/workflows/ci.yml tests at.

# Toolchains.
NODE_VERSION=22.13.0
RUST_VERSION=1.75.0

# The npm agent CLIs, installed globally in the image. The OpenCode and
# OpenClaw pins are load-bearing (see packaging/docker/Dockerfile.ci).
CLAUDE_CODE_VERSION=2.1.295
CODEX_VERSION=0.162.0
OPENCODE_VERSION=1.18.13
# OpenCode 2 (npm @opencode/cli) beside it, under its own prefix with only
# its `opencode2` command on PATH, so `opencode` stays the 1.x pin above. The
# real-binary OpenCode 2 tests find it there (else they SKIP with the reason;
# supported-agents.md §2.3).
OPENCODE2_VERSION=2.0.23
OPENCLAW_VERSION=2026.7.1-2
# The node the agent CLIs whose own engine floor is above Mandu's run on
# (openclaw 2026.7.1-2 refuses node < 22.22.3). Mandu itself is tested on
# NODE_VERSION, its documented minimum; an agent is a separate program with
# its own runtime, as it is on a user's machine.
AGENT_NODE_VERSION=24.21.0

# Agent CLIs shipped as a release binary rather than an npm package: one
# <AGENT>_VERSION + <AGENT>_SHA256 pair each, the sha256 of the
# x86_64-unknown-linux-gnu tarball the project's own installer picks.
# provision.sh's install_release_bin and Dockerfile.ci install it into
# /usr/local/bin and check it runs. An npm agent joins the npm line instead.
# Goose (github.com/aaif-goose/goose): goose-x86_64-unknown-linux-gnu.tar.bz2.
GOOSE_VERSION=1.53.0
GOOSE_SHA256=2d010c66dfd4348bb437b3a94001882468a5db1aa556858920481522f57752d7

# The dependency audit's cargo-audit (continuous-integration.md §14.2), a CI
# tool, not an agent: the RustSec release's static build
# cargo-audit-x86_64-unknown-linux-musl-v<version>.tgz, by sha256 (the
# release's own asset digest). provision.sh installs it; the GitHub audit job
# downloads the same file and checks the same sum.
CARGO_AUDIT_VERSION=0.22.2
CARGO_AUDIT_SHA256=7fb9497f8594b389e5fce5ef9b92db08432996895b2e0c5a0167a69ed445c428

# Comparison baselines (continuous-integration.md §9.10): third-party
# protections the maintainers measure Mandu against, baked into the image
# under /opt/mandu-baselines, each checked by sha256 and run offline.
# fencepost (GPL-3.0-or-later, github.com/ch4nn0n/fencepost): the release's
# fencepost-v<version>.zip, a Claude Code plugin; its secrets scan runs
# gitleaks (MIT), the release's gitleaks_<version>_linux_x64.tar.gz.
FENCEPOST_VERSION=0.13.1
FENCEPOST_SHA256=28719ed71bfcad23f30d95498c251d1c0b313cefa8ce6e336fc7f07bc9b1823c
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
# PrivAiTe (BSD-3-Clause), a redacting API gateway: its wheels and every
# dependency's, spaCy's en_core_web_lg among them, by hash in
# scripts/ci/guest/privaite-requirements.txt (CPython 3.12: the 24.04 guest
# only); its onnx preset's model openai/privacy-filter at this Hugging Face
# revision, each file by sha256 in scripts/ci/guest/privaite-model.sha256.
PRIVAITE_VERSION=0.7.2
PRIVACY_FILTER_REVISION=7ffa9a043d54d1be65afb281eddf0ffbe629385b
# GitGuardian ggshield (MIT): the standalone Linux release,
# ggshield-<version>-x86_64-unknown-linux-gnu.tar.gz, its Claude Code AI hooks
# the ggshield baseline (it scans through GitGuardian's API with the guest's
# `gitguardian` credential, continuous-integration.md §9.8).
GGSHIELD_VERSION=1.55.0
GGSHIELD_SHA256=e12007d9ab2a87d7b8d85c00111123428eb80b8a79d4ab1e8e71f7daf7c21e80
# Docker Sandboxes (proprietary; local sandboxes free to use): the release's
# DockerSandboxes-linux-amd64-ubuntu2404.deb (package docker-sbx, its
# AppArmor profile for the shim's user namespaces included), the 24.04 guest
# only. It signs in with the guest's `docker` credential at run time
# (continuous-integration.md §9.8) and runs microVMs on the guest's nested KVM.
SBX_VERSION=0.48.0
SBX_SHA256=ba972487a0625ca87c2230a65c83a2f7177f97930a74b69c310c1106232c0388
# NVIDIA OpenShell (Apache-2.0, github.com/NVIDIA/OpenShell), a sandbox with
# credential providers, on its MicroVM driver (libkrun, /dev/kvm: the guest
# runs under KVM with the host CPU, so a nested VM works): the release's CLI
# (musl), gateway and VM driver (gnu) tarballs, by sha256. The sandbox image
# (Docker's buildpack-deps:noble-scm: git, curl, ca-certificates) and the VM's
# bootstrap image (the root disk each MicroVM boots and unpacks the sandbox
# image in) by digest. The bootstrap image is Docker's ubuntu:noble-20260930.1,
# a public Ubuntu image in place of OpenShell's default NGC image
# (nvcr.io/nvidia/base/ubuntu:24.04), so every image in the run is under a
# public license: the same Ubuntu 24.04 packages at the same versions as the
# NGC build it replaces (continuous-integration.md §9.10). provision.sh
# prepares the driver's image cache with them once, so a run pulls nothing.
OPENSHELL_VERSION=0.1.4
OPENSHELL_CLI_SHA256=2b65178e62e1ece1d90d482555e9f1f98ff0296e058409b33418104b6333df07
OPENSHELL_GATEWAY_SHA256=43f43554bcaabff2a8147444410d1ad0b7f51bdae7589c2d249982bc8b260b91
OPENSHELL_DRIVER_VM_SHA256=43f1abd8416a1ae6298a39daa7a62b242f55f12f677dadb51b66bffe41e05519
OPENSHELL_SANDBOX_IMAGE=docker.io/library/buildpack-deps
OPENSHELL_SANDBOX_IMAGE_DIGEST=sha256:eb8df607e9320578f1dcd163e74932cf45c88293bfa6af04940fdddaa8a7ff7d
OPENSHELL_BOOTSTRAP_IMAGE=docker.io/library/ubuntu
OPENSHELL_BOOTSTRAP_IMAGE_DIGEST=sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
# nono (Apache-2.0, github.com/nolabs-ai/nono), a Landlock sandbox for
# agents: the release's nono-v<version>-x86_64-unknown-linux-gnu.tar.gz by
# sha256, and its Claude Code pack (nolabs-ai/claude: the claude-code profile
# and a diagnostics plugin) at this version, its profile file by sha256.
NONO_VERSION=0.80.0
NONO_SHA256=6da665b61999570c10dffc7da78828fe1fb7f3cac53319e505cebecaef17037f
NONO_CLAUDE_PACK_VERSION=0.1.4
NONO_CLAUDE_PACK_PROFILE_SHA256=7605ee6226e4c452587c3663b6b00b9b0609fa2c27ceb961abd7d3a7ed4ab8a0
# and its Codex pack (nolabs-ai/codex: the codex profile, installed from the
# pack's policy.json, and a diagnostics skill), the profile file by sha256.
NONO_CODEX_PACK_VERSION=0.2.3
NONO_CODEX_PACK_PROFILE_SHA256=aef23ca6c9e011a7d33af6dd01a3ceed3d9adf7bb2ae8c86359f49937eb03574

# The base image: a dated Ubuntu 24.04 cloud-image release (immutable), checked
# against that release's SHA256SUMS. Bump the date to take a newer point release.
UBUNTU_CLOUD_BASE=https://cloud-images.ubuntu.com/releases/noble
UBUNTU_CLOUD_RELEASE=release-20260926
UBUNTU_CLOUD_IMAGE=ubuntu-24.04-server-cloudimg-amd64.img

# The kernel-tier guest on Linux 7.0 (vm-run.sh --guest ubuntu-2604, the
# `kernel-linux-7` job; continuous-integration.md §4.1): a dated Ubuntu 26.04
# ("resolute") cloud-image release, kernel 7.0.0-34 in release-20260927.
# Provisioned by the same provision.sh from the same pins as the 24.04 image.
UBUNTU_2604_CLOUD_BASE=https://cloud-images.ubuntu.com/releases/resolute
UBUNTU_2604_CLOUD_RELEASE=release-20260927
UBUNTU_2604_CLOUD_IMAGE=ubuntu-26.04-server-cloudimg-amd64.img

# The apt mirror the provisioning boot installs from, in place of both
# archive.ubuntu.com and security.ubuntu.com (2026-09-29: the archive served
# the CI hosts at ~250 kB/s, this mirror at 3 to 4 MB/s). A speed choice, not
# a trust one: apt still checks every package against Ubuntu's signed Release
# files. Changing it changes the image key.
UBUNTU_APT_MIRROR=http://mirror.kakao.com/ubuntu

# The sandbox's bubblewrap (scripts/ci/ns-run.sh). Ubuntu 24.04 ships 0.9.0,
# which has no --overlay-src/--tmp-overlay (added in 0.10.0), so the image
# builds this release from source into /usr/local/lib/mandu-ci/bwrap, OFF the
# PATH: the product under test keeps the distro's /usr/bin/bwrap.
BWRAP_VERSION=0.11.0
BWRAP_SHA256=988fd6b232dafa04b8b8198723efeaccdb3c6aa9c1c7936219d5791a8b7a8646
