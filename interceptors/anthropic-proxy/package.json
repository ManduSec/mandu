{
  "name": "@mandusec/anthropic-proxy",
  "version": "0.2.0-beta.8",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Mandu Track A: Model-API MITM reverse proxy for the Anthropic Messages API. Enforces the AgentView context boundary — symbolizes untrusted tool_result spans before they reach T-LLM, injects the handling system prompt, and records tool_use decisions. Pure userspace TypeScript; reuses the arbiter over IPC. Fail-closed.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "MANDU_AXES_STRICT=1 MANDU_HOME=/dev/null/mandu-test-home MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml tsx --test test/unit/*.test.ts test/component/*.test.ts",
    "test:unit": "MANDU_AXES_STRICT=1 MANDU_HOME=/dev/null/mandu-test-home MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml tsx --test test/unit/*.test.ts",
    "test:component": "MANDU_AXES_STRICT=1 MANDU_HOME=/dev/null/mandu-test-home MANDU_POLICY_FILE=/dev/null/mandu-test-no-policy.yaml tsx --test test/component/*.test.ts",
    "serve": "tsx src/server-main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
